{
  "expo": {
    "name": "UNIlearn Maharashtra",
    "slug": "moodle-lms-mobile",
    "version": "1.0.0",
    "scheme": "com.moodle.lms.app",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#004F7A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#004F7A"
      },
      "package": "in.org.unilearn.mh",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3add74d6-d78f-4af6-8556-d6580af644d3"
      }
    },
    "plugins": [
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
